#   uv pip compile fidelity/oracles/docker/requirements-weasyprint.in --python-version 3.12 \
#     --python-platform linux --generate-hashes -o fidelity/oracles/docker/requirements-weasyprint.txt
#
# Version decision (see ../README.md "WeasyPrint version"): 70.0 (2026-09-08) instead of the
# 62.3 pinned by benchmarks/ (a throughput benchmark, not a layout oracle).
weasyprint==70.0
