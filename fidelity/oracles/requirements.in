# Direct Python dependencies of the host-side oracles (fidelity/.venv, Python 3.12).
# The fully pinned, hash-locked set is requirements.txt, regenerated with:
#   uv pip compile fidelity/oracles/requirements.in --python-version 3.12 --generate-hashes \
#     -o fidelity/oracles/requirements.txt
